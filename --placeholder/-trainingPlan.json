{
  "meta": {
    "sessionsPerWeek": 3,
    "restRuleHours": 48,
    "rpeScale": "1–10",
    "notes": "Never train to failure. RPE 6–8 only."
  },
  "months": [
    {
      "month": 1,
      "phase": {
        "name": "Foundation",
        "focus": "MMaster form. Prepare joints.",
        "targetRPE": "6–7",
        "repGuidance": "6–10"
      },
      "month": 2,
      "phase": {
        "name": "Foundation",
        "focus": "Increase volume slightly.",
        "targetRPE": "6–7",
        "repGuidance": "8–12"
      },
      "month": 3,
      "phase": {
        "name": "Foundation",
        "focus": "Solidify technique.",
        "targetRPE": "7-7",
        "repGuidance": "8–12"
      },
      "month": 4,
      "phase": {
        "name": "Re-Sensitization",
        "focus": "Introduce novelty. Balance.",
        "targetRPE": "7–8",
        "repGuidance": "6–8"
      },
      "month": 5,
      "phase": {
        "name": "Re-Sensitization",
        "focus": "Focus on single-leg control and reintroducing novelty.",
        "targetRPE": "7–8",
        "repGuidance": "6–8"
      },
      "month": 6,
      "phase": {
        "name": "Peak Bone Strain",
        "focus": "Heavier loads. Max signal.",
        "targetRPE": "7.5–8",
        "repGuidance": "5–6"
      },
      "month": 7,
      "phase": {
        "name": "Peak Bone Strain",
        "focus": "Maintain heavy load intensity.",
        "targetRPE": "7.5–8",
        "repGuidance": "5–6"
      },
      "month": 8,
      "phase": {
        "name": "Consolidation",
        "focus": "Reduce fatigue. Recovery.",
        "targetRPE": "7–7.5",
        "repGuidance": "8–10"
      },
      "month": 9,
      "phase": {
        "name": "Consolidation",
        "focus": "Focus on perfect execution.",
        "targetRPE": "7–7.5",
        "repGuidance": "8–10"
      },
      "month": 10,
      "phase": {
        "name": "Second Stimulus",
        "focus": "Re-challenge bone.",
        "targetRPE": "7.5–8",
        "repGuidance": "5–8"
      },
      "month": 11,
      "phase": {
        "name": "Second Stimulus",
        "focus": "Prevent decline.",
        "targetRPE": "7.5–8",
        "repGuidance": "5–8"
      },
      "month": 12,
      "phase": {
        "name": "Maintenance",
        "focus": "Sustain progress.",
        "targetRPE": "7–7.5",
        "repGuidance": "8–12"
      },
      "days": [
        {
          "id": "day1",
          "title": "Lower Body & Spine",
          "intent": "Axial loading for spine and hip bone density.",
          "estimatedTime": "30–35 min",
          "exercises": [
            {
              "id": "bodyweight_squat",
              "name": "Bodyweight Squat",
              "sets": 3,
              "reps": "6-10",
              "why": "Slow tempo. Hips back, chest up. Protects joints."
            },
            {
              "id": "weighted_squat_hold",
              "name": "Weighted Squat Hold",
              "sets": 3,
              "reps": "30-45 sec",
              "why": "Hold at bottom. Sustained axial loading signal."
            },
            {
              "id": "glute_bridge",
              "name": "Glute Bridge",
              "sets": 3,
              "reps": "8-10",
              "why": "2-sec pause at top. Squeeze glutes. Protects back."
            },
            {
              "id": "bent_over_row",
              "name": "Bent-Over Row",
              "sets": 3,
              "reps": "8-10",
              "why": "Flat back. Pull to hip. Posture & spinal load."
            },
            {
            "id": "heel_drops",
              "name": "Heel Drops",
              "sets": 3,
              "reps": "10–15",
              "why": "Lift heels, drop firmly. Impact vibration builds bone."
            },
            {
              "id": "front_plank",
              "name": "Front Plank",
              "sets": 2,
              "reps": "20-30 sec",
              "why": "Tight core. Natural corset for spine."
            }
          ]
        },
        {
          "id": "day2",
          "title": "Upper Body & Impact",
          "intent": "Strength and controlled impact absorption.",
          "estimatedTime": "30 min",
          "exercises": [
            {
              "id": "split_squat",
              "name": "Split Squat",
              "sets": 3,
              "reps": "6–10 / leg",
              "why": "Single-leg loading improves balance and hip bone density."
            },
            {
              "id": "floor_press",
              "name": "Floor Press",
              "sets": 3,
              "reps": "8-12",
              "why": "Safe pushing. Floor protects shoulders."
            },
            {
              "id": "one_arm_row",
              "name": "One-Arm Row",
              "sets": 3,
              "reps": "8-12 / side",
              "why": "Anti-rotation. Core & back strength."
            },
            {
              "id": "standing_overhead_carry",
              "name": "Standing Overhead Carry",
              "sets": 3,
              "reps": "30-60 sec",
              "why": "Weight overhead. Walk. Powerful spinal compression."
            },
            {
              "id": "low_impact_step_downs",
              "name": "Low-Impact Step-Downs",
              "sets": 3,
              "reps": "6–10",
              "why": "Control the descent. Impact absorption skill."
            },
            {
              "id": "dead_bug",
              "name": "Dead Bug",
              "sets": 2,
              "reps": "6–10",
              "why": "Back flat. Deep core stability."
            }
          ]
        },
        {
          "id": "day3",
          "title": "Posterior & Lateral",
          "intent": "Hip strength, balance, and fall prevention.",
          "estimatedTime": "35 min",
          "exercises": [
            {
              "id": "romanian_deadlift",
              "name": "Romanian Deadlift",
              "sets": 3,
              "reps": "8-12",
              "why": "Hip hinge. Hamstrings. Loads femur neck."
            },
            {
              "id": "single_leg_rdl",
              "name": "Single-Leg RDL",
              "sets": 3,
              "reps": "6–10 / leg",
              "why": "Balance + Load. Critical for hip fracture prevention."
            },
            {
              "id": "incline_push_ups",
              "name": "Incline Push-Ups",
              "sets": 3,
              "reps": "6–10",
              "why": "Hands on bench. Wrist/shoulder bone density."
            },
            {
              "id": "reverse_lunge",
              "name": "Reverse Lunge",
              "sets": 2,
              "reps": "6–10 / side",
              "why": "Step back. Controlled single-leg strength."
            },
            {
              "id": "side_lunge",
              "name": "Side Lunge",
              "sets": 2,
              "reps": "6–8 / side",
              "why": "Lateral loading strengthens femoral neck from a new angle."
            },
            {
              "id": "side_plank",
              "name": "Side Plank",
              "sets": 2,
              "reps": "15–25s / side",
              "why": "Lateral loading strengthens femoral neck from a new angle."
            }
          ]
        }
      ]
    }
  ]
}
